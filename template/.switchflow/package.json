{
  "name": "switchflow-project-tools",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Pinned local tooling for the imported Switchflow governance system.",
  "scripts": {
    "board": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-control.ps1",
    "board:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backlog.ps1 browser",
    "control": "node scripts/control/server.mjs --project ..",
    "setup:backlog-fork": "node scripts/backlog-fork/setup.mjs",
    "operations": "node scripts/operations/operations.mjs",
    "board:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backlog.ps1 doctor",
    "docs:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-docs.ps1",
    "phase:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-phase.ps1"
  },
  "devDependencies": {
    "backlog.md": "1.50.1"
  }
}
