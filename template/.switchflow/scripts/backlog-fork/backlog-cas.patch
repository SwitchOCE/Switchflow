@@ -16,3 +16,13 @@ export {
 
 // Re-export types from core types
 export type { MilestoneBucket, MilestoneSummary } from "../../types/index.ts";
+
+import type { Milestone } from "../../types/index.ts";
+/** Explicit scheduling order wins; names provide the stable human-readable fallback. */
+export function compareMilestoneOrder(a: string, b: string, entities: Milestone[]): number {
+  const resolve = (value: string) => entities.find(entity => entity.id === value || entity.title === value);
+  const first = resolve(a);
+  const second = resolve(b);
+  const order = (first?.executionOrder ?? Number.MAX_SAFE_INTEGER) - (second?.executionOrder ?? Number.MAX_SAFE_INTEGER);
+  return order || (first?.title ?? a).localeCompare(second?.title ?? b, undefined, { numeric: true }) || a.localeCompare(b);
+}
