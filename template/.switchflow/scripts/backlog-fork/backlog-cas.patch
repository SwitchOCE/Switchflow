+}
+
+.switchflow-workspace :is(button, a, input, select, textarea, [tabindex]):focus-visible {
+  outline: 2px solid var(--sf-focus) !important;
+  outline-offset: 3px;
+}
+
+.switchflow-workspace [role="dialog"].rounded-lg {
+  border-radius: 12px;
+  border-color: var(--sf-line);
+  box-shadow: 0 24px 80px rgb(19 43 52 / 24%);
+}
+
+/* The markdown editor ships its own theme, outside Tailwind. Only its color
+ * variables are adapted; textarea metrics must match its syntax overlay. */
+.switchflow-workspace :is(.wmde-markdown, .wmde-markdown-var, .w-md-editor) {
+  --color-canvas-default: var(--sf-surface) !important;
