diff --git a/src/web/components/WorkspaceSelector.tsx b/src/web/components/WorkspaceSelector.tsx
new file mode 100644
index 0000000..1644033
--- /dev/null
+++ b/src/web/components/WorkspaceSelector.tsx
@@ -0,0 +1,74 @@
+import { hasUnsavedWorkspaceChanges } from "../hooks/usePageEditor";
+import { useEffect, useState } from "react";
+import Modal from "./Modal";
+import { workspace, workspaceFetch } from "../lib/workspace";
+type Project = { id: string; name: string; available: boolean; activeRun?: unknown; attention?: unknown };
+export default function WorkspaceSelector() {
+  const [projects, setProjects] = useState<Project[]>([]);
+  const [error, setError] = useState("");
+  const [adding, setAdding] = useState(false);
+  const [projectRoot, setProjectRoot] = useState("");
+  const [saving, setSaving] = useState(false);
+  const [addError, setAddError] = useState("");
+  useEffect(() => {
+    if (!workspace) return;
+    let live = true;
+    let pending = false;
+    const refresh = async () => {
+      if (pending) return;
+      pending = true;
+      try {
+        const response = await fetch("/api/projects", { cache: "no-store", signal: AbortSignal.timeout(7000) });
+        if (!response.ok) throw new Error("Project registry unavailable");
+        const data = await response.json();
+        if (live) { setProjects(data.projects); setError(""); }
+      } catch (error) { if (live) setError(error instanceof Error ? error.message : "Project registry unavailable"); }
+      finally { pending = false; }
+    };
+    void refresh();
+    const timer = window.setInterval(() => { if (!document.hidden) void refresh(); }, 8000);
+    return () => { live = false; window.clearInterval(timer); };
+  }, []);
+  if (!workspace) return null;
+  return <div className="sf-project-picker flex items-center gap-2">
+    <label htmlFor="workspace-project" className="text-sm text-gray-500 dark:text-gray-400">Project</label>
+    <select id="workspace-project" value={workspace.projectId} className="sf-project-select rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1 text-sm text-gray-900 dark:text-gray-100" onChange={event => {
+      const selected = projects.find(project => project.id === event.target.value);
+      if (!selected?.available || !workspace) return;
+      // A full navigation invokes native beforeunload guards for document/settings editors.
+      // Dialog edits are guarded explicitly because some upstream forms only guard local close.
+      if (hasUnsavedWorkspaceChanges() && !window.confirm("Switch projects? Any unsaved changes on this page will be lost.")) return;
+      const view = window.location.pathname.slice(workspace.basename.length);
+      const safeView = /^\/(board|tasks|drafts|milestones|documentation|decisions|statistics|settings|switchflow)(?:\/|$)/.exec(view)?.[1] ?? "board";
+      window.location.assign(`/projects/${selected.id}/backlog/${safeView}`);
+    }}>
+      {!projects.length && <option value={workspace.projectId}>Current project</option>}
+      {projects.map(project => <option key={project.id} value={project.id} disabled={!project.available}>{project.name}{!project.available ? " (unavailable)" : project.activeRun ? " (agent running)" : project.attention ? " (needs attention)" : ""}</option>)}
+    </select>
+    <button type="button" className="rounded-md border border-gray-300 dark:border-gray-600 px-2 py-1 text-sm text-gray-900 dark:text-gray-100" onClick={() => setAdding(true)}>Add project</button>
+    <span className="sf-project-summary text-xs text-gray-500 dark:text-gray-400">{projects.filter(project => project.activeRun).length} running · {projects.filter(project => project.attention).length} need attention</span>
+    <Modal isOpen={adding} onClose={() => { if (!saving) setAdding(false); }} title="Add project" maxWidthClass="max-w-lg">
+      <form className="space-y-4" onSubmit={async event => {
+        event.preventDefault();
+        if (!projectRoot.trim() || saving) return;
+        setSaving(true); setAddError("");
+        try {
+          const response = await workspaceFetch("/api/projects", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ projectRoot: projectRoot.trim() }) });
+          const result = await response.json();
+          if (!response.ok) throw new Error(result.error || "Could not add project");
+          const registry = await fetch("/api/projects", { cache: "no-store" });
+          if (!registry.ok) throw new Error("Project added, but registry refresh failed. Retry to refresh.");
+          setProjects((await registry.json()).projects);
+          setAdding(false); setProjectRoot("");
+        } catch (error) { setAddError(error instanceof Error ? error.message : "Could not add project"); }
+        finally { setSaving(false); }
+      }}>
+        <label className="block text-sm text-gray-900 dark:text-gray-100">Project folder<input autoFocus value={projectRoot} onChange={event => setProjectRoot(event.target.value)} placeholder="C:\projects\my-project" className="mt-2 block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 p-2" /></label>
+        <p className="text-sm text-gray-500 dark:text-gray-400">Enter the absolute path to an existing project folder.</p>
+        {addError && <p role="alert" className="text-sm text-red-600 dark:text-red-400">{addError}</p>}
+        <div className="flex justify-end gap-2"><button type="button" disabled={saving} onClick={() => setAdding(false)}>Cancel</button><button type="submit" disabled={saving || !projectRoot.trim()} className="rounded-md bg-blue-600 px-3 py-2 text-sm text-white disabled:opacity-50">{saving ? "Adding…" : "Add project"}</button></div>
+      </form>
+    </Modal>
+    {error && <span role="alert" className="text-sm text-red-600">{error}</span>}
+  </div>;
+}
