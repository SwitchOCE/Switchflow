diff --git a/src/file-system/rename-staged-file.ts b/src/file-system/rename-staged-file.ts
new file mode 100644
index 0000000..6c326d5
--- /dev/null
+++ b/src/file-system/rename-staged-file.ts
@@ -0,0 +1,18 @@
+import { rename } from "node:fs/promises";
+
+/** Windows readers can briefly deny replacement; never delete the destination as a fallback. */
+export async function renameStagedFile(
+  source: string,
+  destination: string,
+  options: { platform?: string; renameFile?: typeof rename } = {},
+): Promise<void> {
+  const renameFile = options.renameFile ?? rename;
+  for (let attempt = 0; ; attempt++) {
+    try { await renameFile(source, destination); return; }
+    catch (error) {
+      const code = (error as NodeJS.ErrnoException)?.code;
+      if ((options.platform ?? process.platform) !== "win32" || !["EPERM", "EACCES", "EBUSY"].includes(code ?? "") || attempt >= 4) throw error;
+      await new Promise(resolve => setTimeout(resolve, 25 * 2 ** attempt));
+    }
+  }
+}
