+ expect(parsed.context).toContain("## Unknown");
+});
+
+test("failed decision rename keeps the original filename and bytes", async () => {
+ const created = await (await request("decisions", "POST", {title: "Stable original", content})).json();
+ const before = await filesystem.loadDecision(created.id);
+ const response = await request(`decisions/${created.id}`, "PUT", {title: "a".repeat(400), content: content.replace("Persist everything", "Must not replace")});
