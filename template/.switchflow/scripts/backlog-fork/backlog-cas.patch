+/* Shared-workspace presentation only. The native diagnostic UI does not receive
+ * the switchflow-workspace root class. Keep dimensions and interaction states
+ * owned by the upstream components; these tokens adapt their visual language. */
+.switchflow-workspace {
+  --sf-canvas: #f6f7f8;
+  --sf-surface: #ffffff;
+  --sf-subtle: #eef2f2;
