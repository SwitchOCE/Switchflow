+}
+
+.switchflow-workspace :is(.sf-task-card, [role="button"][draggable].p-3) {
+  border-radius: 8px;
+  background: var(--sf-surface);
+  box-shadow: var(--sf-shadow);
+}
+
+.switchflow-workspace :is(.sf-task-card, [role="button"][draggable].p-3)[draggable="true"]:hover {
+  border-color: #98b8af;
