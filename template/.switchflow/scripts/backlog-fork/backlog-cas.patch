+   * a full ramp retains hover, opacity, ring, and dark-variant behavior. */
+  --color-gray-50: #f6f7f8;
+  --color-gray-100: #eef2f2;
+  --color-gray-200: #dfe4e6;
+  --color-gray-300: #cdd6da;
+  --color-gray-400: #84939b;
+  --color-gray-500: #65717a;
+  --color-gray-600: #4f5d65;
+  --color-gray-700: #35454a;
+  --color-gray-800: #233237;
+  --color-gray-900: #172328;
+  --color-gray-950: #101a1e;
+  --color-blue-50: #eaf5f0;
+  --color-blue-100: #d5ebe2;
+  --color-blue-200: #b0d7c7;
+  --color-blue-300: #80bfaa;
+  --color-blue-400: #56ac94;
+  --color-blue-500: #126b5d;
+  --color-blue-600: #0e6154;
+  --color-blue-700: #0a5045;
+  --color-blue-800: #123f38;
+  --color-blue-900: #17372f;
+  --color-blue-950: #0d2520;
+  --font-sans: Inter, "Segoe UI", system-ui, -apple-system, sans-serif;
+  font-family: var(--font-sans);
+  font-synthesis: none;
+  color: var(--sf-ink);
+  background: var(--sf-canvas);
+  color-scheme: light;
+}
+
+.switchflow-workspace.dark {
+  --sf-canvas: #172328;
+  --sf-surface: #233237;
+  --sf-subtle: #2c3e43;
+  --sf-ink: #ecf1f2;
+  --sf-muted: #aab9bf;
+  --sf-line: #405358;
+  --sf-accent: #80cfb6;
+  --sf-accent-hover: #a5e0cc;
+  --sf-accent-soft: #1f4239;
+  --sf-focus: #8bc1e8;
+  --sf-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+  --sf-shadow-raised: 0 5px 18px rgb(0 0 0 / 22%);
+  color-scheme: dark;
+}
+
+/* Navigation: retain the native full sidebar, collapsed rail, and scroll areas. */
+.switchflow-workspace :is(.sf-sidebar, .relative.border-r.flex.flex-col.min-h-full) {
+  background: var(--sf-surface);
+  border-color: var(--sf-line);
+}
+
+.switchflow-workspace :is(.sf-topbar, nav.h-18.border-b) {
+  background: var(--sf-surface);
+  border-color: var(--sf-line);
+}
+
+.switchflow-workspace :is(.sf-topbar, nav.h-18.border-b) h1 {
+  font-size: 1.0625rem;
+  font-weight: 650;
+  letter-spacing: -.025em;
+}
+
+/* Workspace controls must fit the space beside the sidebar, not assume the
+ * full viewport is available. The header may grow when controls wrap. */
+.switchflow-workspace .sf-topbar {
+  height: auto;
+  min-height: 4.5rem;
+  flex-shrink: 0;
+  padding-block: .875rem;
+}
+
+.switchflow-workspace .sf-topbar > .flex {
