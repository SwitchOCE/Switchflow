--- /dev/null
+++ b/src/web/hooks/usePageEditor.ts
@@ -0,0 +1,22 @@
+import { useEffect } from "react";
+const activeEditors = new Set<symbol>();
+export const hasActivePageEditor = () => activeEditors.size > 0;
+export function usePageEditor(editing: boolean) {
+  useEffect(() => {
+    if (!editing) return;
+    const editor = Symbol("native page editor");
+    activeEditors.add(editor);
+    return () => { activeEditors.delete(editor); };
+  }, [editing]);
+}
+
+const unsavedEditors = new Set<symbol>();
+export const hasUnsavedWorkspaceChanges = () => unsavedEditors.size > 0;
+export function useUnsavedWorkspaceChanges(dirty: boolean) {
+  useEffect(() => {
+    if (!dirty) return;
+    const editor = Symbol("unsaved editor");
+    unsavedEditors.add(editor);
+    return () => { unsavedEditors.delete(editor); };
+  }, [dirty]);
+}
