diff --git a/src/server/switchflow-bridge.ts b/src/server/switchflow-bridge.ts
new file mode 100644
index 0000000..d0c8c42
--- /dev/null
+++ b/src/server/switchflow-bridge.ts
@@ -0,0 +1,77 @@
+import { BacklogServer } from "./index.ts";
+
+const MAX_REQUEST = 1024 * 1024;
+const MAX_REPLY = 16 * 1024 * 1024;
+
+/** JSONL transport only: initialization never calls Bun.serve or opens a listener. */
+export async function runSwitchflowBridge(): Promise<void> {
+	console.log = console.info = console.debug = console.error;
+	const server = new BacklogServer(process.cwd());
+	const write = async (value: unknown) => {
+		const line = `${JSON.stringify(value)}\n`;
+		await new Promise<void>((resolve, reject) => process.stdout.write(line, error => error ? reject(error) : resolve()));
+	};
+	let stopping = false;
+	const stop = () => { stopping = true; process.stdin.destroy(); };
+	process.once("SIGINT", stop);
+	process.once("SIGTERM", stop);
+	try {
+		await server.initializeBridge();
+		let pending = Buffer.alloc(0);
+		let discarding = false;
+		for await (const chunk of process.stdin) {
+			if (stopping) break;
+			pending = Buffer.concat([pending, Buffer.from(chunk)]);
+			while (pending.length) {
+				const newline = pending.indexOf(10);
+				if (newline < 0) {
+					if (pending.length > MAX_REQUEST) {
+						if (!discarding) await write({ id: null, error: "Request exceeds 1 MiB" });
+						discarding = true; pending = Buffer.alloc(0);
+					}
+					break;
+				}
+				const line = pending.subarray(0, newline);
+				pending = pending.subarray(newline + 1);
+				if (discarding) { discarding = false; continue; }
+				if (line.length > MAX_REQUEST) { await write({ id: null, error: "Request exceeds 1 MiB" }); continue; }
+				let id: string | number | null = null;
+				try {
+					const message = JSON.parse(line.toString("utf8"));
+					if (typeof message.id !== "string" && typeof message.id !== "number") throw new Error("Request id required");
+					id = message.id;
+					if (typeof message.path !== "string" || !/^\/(api|assets)\//.test(message.path) || /[\\\r\n#]/.test(message.path)) throw new Error("Route not allowed");
+					if (!["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"].includes(message.method)) throw new Error("Method not allowed");
+					const contentType = message.contentType ?? "application/json";
+					if (!["application/json", "text/plain"].includes(contentType)) throw new Error("Content type not allowed");
+					const url = new URL(message.path, "http://switchflow.invalid");
+					if (url.origin !== "http://switchflow.invalid") throw new Error("Route not allowed");
+					const body = message.body === undefined ? undefined : typeof message.body === "string" ? message.body : JSON.stringify(message.body);
+					if (message.method === "PUT" && /^\/api\/(tasks|milestones)\/[^/]+$/.test(url.pathname)) {
+						const payload = body ? JSON.parse(body) : {};
+						if (typeof payload.expectedRevision !== "string" || !/^[a-f0-9]{64}$/.test(payload.expectedRevision)) {
+							await write({ id, status: 400, headers: { "content-type": "application/json" }, body: Buffer.from(JSON.stringify({ error: "A valid expectedRevision is required; reload before editing" })).toString("base64") });
+							continue;
+						}
+					}
+					const response = await server.dispatchApi(new Request(url, { method: message.method, headers: { "Content-Type": contentType }, body }));
+					const chunks: Uint8Array[] = [];
+					let length = 0;
+					if (response.body) for await (const bytes of response.body) {
+						length += bytes.length;
+						if (length > MAX_REPLY) throw new Error("Reply exceeds 16 MiB");
+						chunks.push(bytes);
+					}
+					await write({ id, status: response.status, headers: Object.fromEntries(response.headers), body: Buffer.concat(chunks).toString("base64") });
+				} catch (error) { await write({ id, error: error instanceof Error ? error.message : String(error) }); }
+			}
+		}
+		if (pending.length && !discarding) await write({ id: null, error: "Unterminated request" });
+	} catch (error) {
+		if (!stopping) throw error;
+	} finally {
+		process.removeListener("SIGINT", stop);
+		process.removeListener("SIGTERM", stop);
+		await server.stop();
+	}
+}
