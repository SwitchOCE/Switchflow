+/** Routing identity is bound to the page URL, never the mutable default project. */
+export function workspaceRoute(pathname: string) {
+  const match = /^\/projects\/([a-f0-9]{64})\/backlog(?:\/|$)/.exec(pathname);
+  return match ? { projectId: match[1]!, basename: `/projects/${match[1]}/backlog`, apiBase: `/api/projects/${match[1]}/native` } : null;
+}
+export const workspace = typeof window === "undefined" ? null : workspaceRoute(window.location.pathname);
+export const API_BASE = workspace?.apiBase ?? "/api";
+export async function workspaceFetch(url: string, options: RequestInit = {}): Promise<Response> {
+  const headers = new Headers(options.headers);
+  if (workspace && !["GET", "HEAD"].includes((options.method ?? "GET").toUpperCase())) {
+    const registryResponse = await fetch("/api/projects", { cache: "no-store", signal: options.signal });
+    if (!registryResponse.ok) throw new Error("Could not authenticate this workspace. Reload and try again.");
+    const registry = await registryResponse.json();
+    if (!registry.csrfToken) throw new Error("Workspace security token is unavailable. Reload and try again.");
+    headers.set("X-Switchflow-Token", registry.csrfToken);
+  }
+  return fetch(url, { ...options, headers });
+}
