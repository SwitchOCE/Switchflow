+ directory = createUniqueTestDir("decision-editor-persistence");
+ filesystem = new FileSystem(directory);
+ await filesystem.ensureBacklogStructure();
+ await filesystem.saveConfig({projectName: "Decisions", statuses: ["To Do", "Done"], labels: [], milestones: [], dateFormat: "YYYY-MM-DD", remoteOperations: false, autoCommit: false});
+ server = new BacklogServer(directory);
+});
+afterEach(async () => { await server.stop(); await safeCleanup(directory); });
+const request = (path: string, method: string, body: unknown) => server.dispatchApi(new Request(`http://localhost/api/${path}`, {method, headers: {"Content-Type": "application/json"}, body: JSON.stringify(body)}));
+const content = "## Context\n\nOriginal context\n\n### Details\n\nNested content\n\n## Decision\n\nPersist everything\n\n## Consequences\n\nVisible impact\n\n## Alternatives\n\nAlternative path";
+test("single decision create persists title and all editor content; edit renames and clears sections", async () => {
+ const createdResponse = await request("decisions", "POST", {title: "Original title", content});
+ expect(createdResponse.status).toBe(201);
+ const created = await createdResponse.json();
+ const saved = await filesystem.loadDecision(created.id);
+ expect(saved?.title).toBe("Original title");
+ expect(saved?.context).toContain("Nested content");
+ expect(saved?.decision).toBe("Persist everything");
+ expect(saved?.alternatives).toBe("Alternative path");
+ const edited = "## Context\n\n\n## Decision\n\nEdited body\n\n## Consequences\n\n";
+ const editedResponse = await request(`decisions/${created.id}`, "PUT", {title: "Renamed title", content: edited});
+ expect(editedResponse.status).toBe(200);
+ const reloaded = await filesystem.loadDecision(created.id);
+ expect(reloaded?.title).toBe("Renamed title");
+ expect(reloaded?.context).toBe("");
+ expect(reloaded?.decision).toBe("Edited body");
+ expect(reloaded?.consequences).toBe("");
+ expect(reloaded?.alternatives).toBeUndefined();
+});
+test("unsupported text fails before creation or changes to an existing decision", async () => {
+ expect((await request("decisions", "POST", {title: "Do not create", content: "unstructured unsaved draft"})).status).toBe(400);
+ expect(await filesystem.listDecisions()).toHaveLength(0);
+ const created = await (await request("decisions", "POST", {title: "Original", content})).json();
+ const response = await request(`decisions/${created.id}`, "PUT", {title: "Should not rename", content: content + "\n\n## Unsupported\n\nDo not drop this"});
+ expect(response.status).toBe(400);
+ const unchanged = await filesystem.loadDecision(created.id);
+ expect(unchanged?.title).toBe("Original");
+ expect(unchanged?.decision).toBe("Persist everything");
+});
