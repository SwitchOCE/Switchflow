+      if (!["context", "decision", "consequences", "alternatives"].includes(name) || sections.has(name)) throw new DecisionEditorError("Use one each of ## Context, ## Decision and ## Consequences, plus optional ## Alternatives. Put other headings inside a section using ###.");
