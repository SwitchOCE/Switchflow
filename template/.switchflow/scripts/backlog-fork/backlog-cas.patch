+++ b/src/test/rename-staged-file.test.ts
@@ -0,0 +1,36 @@
+import { expect, test } from "bun:test";
+import { mkdtemp, readFile, rename, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { renameStagedFile } from "../file-system/rename-staged-file.ts";
+
+test("Windows transient replacement denial retries without removing saved bytes", async () => {
+  const root = await mkdtemp(join(tmpdir(), "backlog-staged-"));
+  const source = join(root, "staged.tmp"), destination = join(root, "saved.md");
+  try {
+    await writeFile(source, "replacement"); await writeFile(destination, "saved");
+    let attempts = 0;
+    await renameStagedFile(source, destination, { platform: "win32", renameFile: async (from, to) => {
+      expect(await readFile(destination, "utf8")).toBe("saved");
+      if (++attempts < 3) throw Object.assign(new Error("sharing violation"), { code: "EPERM" });
+      await rename(from, to);
+    } });
+    expect(attempts).toBe(3); expect(await readFile(destination, "utf8")).toBe("replacement");
+    await writeFile(source, "unsaved"); attempts = 0;
+    await expect(renameStagedFile(source, destination, { platform: "win32", renameFile: async () => {
+      attempts++; throw Object.assign(new Error("persistent denial"), { code: "EPERM" });
+    } })).rejects.toThrow("persistent denial");
+    expect(attempts).toBe(5); expect(await readFile(destination, "utf8")).toBe("replacement");
+    expect(await readFile(source, "utf8")).toBe("unsaved");
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("non-transient errors and other platforms fail immediately", async () => {
+  for (const [platform, code] of [["win32", "ENAMETOOLONG"], ["linux", "EPERM"]]) {
+    let attempts = 0;
+    await expect(renameStagedFile("source", "destination", { platform, renameFile: async () => {
+      attempts++; throw Object.assign(new Error(code), { code });
+    } })).rejects.toThrow(code);
+    expect(attempts).toBe(1);
+  }
+});
