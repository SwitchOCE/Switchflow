+}
+
+.switchflow-workspace :is(.sf-task-card, [role="button"][draggable].p-3) h4 {
+  line-height: 1.5;
+  font-weight: 600;
+}
+
+/* Small metadata needs more contrast than upstream gray-400 on white. This
+ * deliberately targets text utilities, never disabled-control opacity. */
+.switchflow-workspace:not(.dark) .text-gray-400 {
+  color: var(--sf-muted);
+}
+
+.switchflow-workspace.dark :is(.dark\:text-gray-400, .dark\:text-gray-500) {
